# TVL SmartCare Backend Environment Variables
PORT=5000

# MongoDB Connection String:
# 1. Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/mediqueue

# 2. Or MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/mediqueue?retryWrites=true&w=majority

# JWT Secret for Auth Token signing
JWT_SECRET=your_jwt_secret_token_here
