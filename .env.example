# TVL SmartCare - Environment Configuration Template
PORT=5000

# MongoDB Connection String:
# 1. Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/mediqueue

# 2. MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/mediqueue?retryWrites=true&w=majority

# JWT Secret for Authentication
JWT_SECRET=your_secure_jwt_secret_key_here

# Google OAuth 2.0 Client ID
# Obtain from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend API Base URL (Defaults to /api on Vercel or http://localhost:5000/api in dev)
VITE_API_URL=/api
VITE_API_BASE_URL=/api
